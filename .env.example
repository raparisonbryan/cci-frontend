# Copier ce fichier en .env.local et renseigner les valeurs

# URL de l'API backend (cci-backend)
NEXT_PUBLIC_API_URL=http://localhost:3001

# URL du serveur WebSocket (par défaut : wss://cci-api.com/socket)
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# NextAuth
NEXTAUTH_URL=http://localhost:3000
# Générer avec : openssl rand -base64 32
# Doit être IDENTIQUE au NEXTAUTH_SECRET du backend
NEXTAUTH_SECRET=
# Domaine du cookie de session, partagé avec l'API (en prod : .cci-api.com ; vide en local)
NEXTAUTH_COOKIE_DOMAIN=

# OAuth Google (console.cloud.google.com > Identifiants)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
